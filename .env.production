# Used only for production builds (npm run build). Local dev still uses the
# Vite proxy in vite.config.js, which talks to auth-service/core-service
# directly on localhost.
#
# Both point at the same URL because the gateway itself splits traffic
# between auth-service and core-service based on path — the frontend no
# longer needs to know they're two separate backends.
VITE_AUTH_API_BASE_URL=https://api-gateway-1042646562056.us-central1.run.app/api/v1
VITE_CORE_API_BASE_URL=https://api-gateway-1042646562056.us-central1.run.app/api/v1
